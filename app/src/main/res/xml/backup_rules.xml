<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de backup (Android <= 12 / API <= 30).
   NOTA: los tokens de sesión (cifrados con Android Keystore) no deben salir del
   dispositivo, ni siquiera como ciphertext. Se excluyen los archivos de prefs
   sensibles del Auto Backup. El resto de datos de la app (Room, estado, etc.)
   sí se sigue respaldando.
   Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Sesión (tokens JWT) cifrados -->
    <exclude domain="sharedpref" path="sifa_session_enc.xml"/>
    <!-- FCM push token cifrado -->
    <exclude domain="sharedpref" path="sifa_push_enc.xml"/>

    <!-- Archivos legacy en texto plano (antes de la migración one-time) -->
    <exclude domain="sharedpref" path="sifa_session.xml"/>
    <exclude domain="sharedpref" path="sifa_push.xml"/>
</full-backup-content>